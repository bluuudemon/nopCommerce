# Feature overlay: replace only Nop.Web + views/CSS/strings; keep published binaries for shipping/plugins.
FROM nopcommerceteam/nopcommerce:latest AS base
FROM nopdemo:sha-e3ba85b324bb AS feature_src
FROM scratch AS bundle
COPY --from=feature_src /app/Nop.Web.dll /bundle/
COPY --from=feature_src /app/Views /bundle/Views
COPY --from=feature_src /app/Themes/DefaultClean/Content/css/styles.css /bundle/styles.css
COPY --from=feature_src /app/Themes/DefaultClean/Content/css/styles.rtl.css /bundle/styles.rtl.css
COPY --from=feature_src /app/App_Data/Localization/defaultResources.nopres.xml /bundle/defaultResources.nopres.xml
FROM base
USER root
COPY --from=bundle /bundle/Nop.Web.dll /app/
COPY --from=bundle /bundle/Views /app/Views
COPY --from=bundle /bundle/styles.css /app/Themes/DefaultClean/Content/css/styles.css
COPY --from=bundle /bundle/styles.rtl.css /app/Themes/DefaultClean/Content/css/styles.rtl.css
COPY --from=bundle /bundle/defaultResources.nopres.xml /app/App_Data/Localization/defaultResources.nopres.xml
RUN chown -R app:app /app
USER app
